# انسخ الأسماء إلى إعدادات Vercel. لا ترفع ملف .env إلى GitHub.

# رابط Postgres من Supabase: Connect → Session pooler (المنفذ 5432).
# هذا المفتاح سري ويُقرأ من السيرفر فقط.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# مفتاحان عامان. يجب أن يكونا موجودين أثناء البناء لأن Vite يدمجهما في الواجهة.
# من Supabase: Project Settings → API
VITE_SUPABASE_URL=https://PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# اختياري لاحقًا للدفع. اتركه فارغًا الآن.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# MOYASAR_SECRET_KEY=
# TAP_SECRET_KEY=

# سري. يُستخدم فقط على السيرفر لمولّد الأسئلة ومراجعتها. لا تضفه في ملفات الواجهة.
# XAI_API_KEY=

# رمز تأسيس أول مدير. الافتراضي في الواجهة LAMMA-HOST ويمكن تغييره من الإعدادات لاحقًا.
# Required in production. No default code is accepted.
ADMIN_BOOTSTRAP_CODE=
ADMIN_SESSION_SECRET=

# Optional: Cloudflare Web Analytics token (Cloudflare dashboard → Analytics & Logs → Web Analytics).
# Not needed if Web Analytics is turned on from the Cloudflare Pages project, which injects it by itself.
VITE_CF_BEACON_TOKEN=
